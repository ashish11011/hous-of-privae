# Database
DATABASE_URL=

# AWS Cognito
AWS_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Leave blank if the Cognito app client has no secret.
COGNITO_CLIENT_SECRET=
# Optional override. Defaults to https://cognito-idp.${AWS_REGION}.amazonaws.com/${COGNITO_USER_POOL_ID}
COGNITO_ISSUER=

# Auth cookies
NEXTAUTH_URL=
NEXTAUTH_SECRET=
# Keep true in production. Set to false only for local HTTP development.
AUTH_COOKIE_SECURE=true
# Match your Cognito app client's refresh token validity in seconds.
COGNITO_REFRESH_TOKEN_COOKIE_MAX_AGE=2592000

# Public site URL
NEXT_PUBLIC_BASE_URL=

# S3 uploads
NEXT_PUBLIC_S3_REGION=
NEXT_PUBLIC_S3_BUCKET_NAME=
NEXT_PUBLIC_S3_ACCESS_KEY=
NEXT_S3_SECRET_KEY=

# Email/admin notifications
ADMIN_EMAIL_ID=

# Razorpay: use matching test or live API keys.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Separate secret configured on the Razorpay webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# Gift cards: stable server-only secret of at least 32 characters.
# Falls back to NEXTAUTH_SECRET if omitted. Keep stable for existing card codes.
GIFT_CARD_ENCRYPTION_KEY=
